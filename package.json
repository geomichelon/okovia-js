{
  "name": "okovia",
  "version": "0.2.0",
  "description": "OkOvia browser telemetry SDK — sends product behavior context (no prompts, responses, or sensitive data) so AI cost can be attributed to features.",
  "license": "MIT",
  "homepage": "https://okovia.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/geomichelon/okovia-js.git"
  },
  "bugs": {
    "url": "https://github.com/geomichelon/okovia-js/issues"
  },
  "keywords": [
    "okovia",
    "telemetry",
    "ai",
    "llm",
    "cost",
    "observability",
    "analytics"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "okovia": "./bin/okovia.mjs"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=16.16"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:tag": "esbuild src/tag.ts --bundle --format=iife --minify --target=es2019 --banner:js=\"/* OkOvia Tag — generated from sdks/javascript (npm run build:tag). Do not edit. */\" --outfile=../../apps/web/public/js/okovia.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "typescript": "^5.2.0",
    "vitest": "0.34.6"
  }
}
